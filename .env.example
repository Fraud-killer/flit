# FLIT Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env.

# =============================================================================
# REQUIRED - Application will not start without these
# =============================================================================

# Django secret key - generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Fernet key used to encrypt sensitive data - generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCRYPT_KEY=

# Database connection string (docker-compose overrides this for local dev)
DATABASE_URL=postgres://user:password@localhost:5432/flit

# =============================================================================
# RECOMMENDED - For production deployments
# =============================================================================

# Redis for channels and caching
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# Allowed hosts and CSRF origins (JSON arrays)
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
CSRF_TRUSTED_ORIGINS=[]

# Debug mode (keep False in production)
DEBUG=False

# Redirect HTTP to HTTPS when DEBUG is False. Set to False if a proxy
# terminates TLS and already redirects.
SECURE_SSL_REDIRECT=True

# =============================================================================
# OPTIONAL - Intelligence and third-party integrations
# =============================================================================

# Fingerprint.com keys for device identification and Smart Signals
FINGERPRINT_SERVER_API_KEY=
FINGERPRINT_MANAGEMENT_API_KEY=

# Directory holding MaxMind GeoLite2-ASN.mmdb and GeoLite2-Country.mmdb
# (free download: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data)
GEOIP_DB_PATH=

# Plain-text IP blocklist (one IP or CIDR per line) loaded by
# `python manage.py refresh_threat_intel`
THREAT_LIST_URL=https://raw.githubusercontent.com/firehol/blocklist-ipsets/master/firehol_level1.netset

# =============================================================================
# OPTIONAL - Step-up challenges
# =============================================================================

# Cloudflare Turnstile secret, used when an application has not set its own.
# Only needed if you issue turnstile challenges; OTP challenges need nothing.
TURNSTILE_SECRET_KEY=

# =============================================================================
# OPTIONAL - Outbound intelligence lookups
# =============================================================================
# All three are on by default and degrade to "unknown" rather than failing a
# decision. Turn them off where there is no egress.

# Domain age and MX records, over DNS-over-HTTPS and RDAP.
DOMAIN_LOOKUPS_ENABLED=True

# Whether a funding wallet has any on-chain history, over public JSON-RPC.
CHAIN_LOOKUPS_ENABLED=True

# Your own RPC endpoints, as a JSON map, merged over the public defaults.
# Worth setting: the defaults are shared public nodes and are rate limited.
#   {"polygon": "https://...", "base": "https://..."}
CHAIN_RPC_URLS=

# OFAC SDN list, loaded by `python manage.py refresh_sanctions`. The file is
# parsed for digital currency addresses, so point this only at a source you
# trust as much as Treasury itself.
SANCTIONS_LIST_URL=https://www.treasury.gov/ofac/downloads/sdn.xml
