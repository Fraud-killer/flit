# FLIT Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Application will not start without these
# =============================================================================

# Django secret key - generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-minimum-50-characters-long

# Encryption key for sensitive data (32 characters)
MCRYPT_KEY=your-32-character-encryption-key

# Database connection string
DATABASE_URL=postgres://user:password@localhost:5432/flit

# =============================================================================
# RECOMMENDED - For production deployments
# =============================================================================

# Redis for caching and real-time features
REDIS_URL=redis://localhost:6379/0

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Debug mode (set to False in production!)
DEBUG=True

# =============================================================================
# OPTIONAL - Third-party integrations
# =============================================================================

# Fingerprint.com API key for device identification
FINGERPRINT_API_KEY=

# Sentry DSN for error tracking
SENTRY_DSN=

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Use in-memory cache instead of Redis
USE_MEMORY_CACHE=True

# Skip email verification
SKIP_EMAIL_VERIFICATION=True
